{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|apply_patch|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-policy-guard.mjs codex PreToolUse",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-session-owner-guard.mjs codex PreToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Bash|shell|run_shell|run_shell_command|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/destructive-git-guard.mjs codex PreToolUse",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/commit-guard.mjs codex PreToolUse",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-session-owner-guard.mjs codex PreToolUse",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/pre-ship-review-guard.mjs codex PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|shell|run_shell|run_shell_command|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-owner-tracker.mjs codex PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-shipping-guard.mjs codex Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
