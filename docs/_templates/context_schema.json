{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context_schema.json",
  "title": "Feature Context Schema",
  "description": "{{PROJECT_NAME}} プロジェクトの機能開発統合コンテキストスキーマ。AIがCONTEXT.jsonを生成/修正する際に参照するルール定義。",

  "type": "object",
  "required": [
    "schema_version",
    "feature_id",
    "title",
    "quick_resume",
    "why",
    "artifacts",
    "brief_context",
    "traceability",
    "execution",
    "decisions",
    "history",
    "autonomy_control",
    "progress"
  ],

  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [5, 6, 7, 8],
      "description": "スキーマバージョン。v5: 必須13項目、progress.detailsはobject専用、competitive_data追加、artifacts.brief_format_version追加。v6: architectureセクション追加（Phase 0 Discovery & Architecture）。v7: completion_contractセクション追加（3層DoDシステム）。v8: characteristicsベースのTier廃止 + completion_summary追加（GSD Feature Completion Summary）"
    },

    "feature_id": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$",
      "description": "機能ID（例: 001-user-dashboard）"
    },

    "title": {
      "type": "string",
      "minLength": 2,
      "description": "機能タイトル"
    },

    "feature_type": {
      "type": "string",
      "enum": ["ui_feature", "backend_feature", "system_feature", "strategy_feature"],
      "description": "機能種別の分類。ui_feature: ユーザー向け画面あり（screens/必須）、backend_feature: サーバーロジック専用（API Route、DB）、system_feature: インフラ/プラットフォーム（オフライン、プッシュ通知）、strategy_feature: ビジネス戦略（UA、リテンション）。feature-architectがCONTEXTを生成する際に必ず設定する。"
    },

    "domain": {
      "type": ["string", "null"],
      "description": "ビジネスドメイン帰属（docs/features/domain-map.json#domains[].id 参照）。feature_type が技術分類であれば、domain はビジネス境界の分類。feature-pilot Phase 0 の Domain Placement 判定結果を feature-architect が記録する。新規ドメインの場合は domain-map.json にドメイン定義を先に追加する。"
    },

    "characteristics": {
      "type": "object",
      "description": "Feature Characteristics。feature-architectが自動検出。スキル実行条件とSPEC深度判定の基盤。",
      "properties": {
        "involves_new_api": { "type": "boolean", "default": false, "description": "プロジェクト内で新規API Routeを作成" },
        "involves_external_api": { "type": "boolean", "default": false, "description": "外部サービスAPI連携" },
        "db_schema_change": { "type": "boolean", "default": false, "description": "DBスキーマ変更/マイグレーション" },
        "multi_screen": { "type": "boolean", "default": false, "description": "2画面以上にまたがる機能" },
        "ai_ml_integration": { "type": "boolean", "default": false, "description": "AI/MLモデル連携" },
        "security_sensitive": { "type": "boolean", "default": false, "description": "認証/権限に関わるコード修正" },
        "realtime_processing": { "type": "boolean", "default": false, "description": "リアルタイムデータ処理（WebSocketなど）" },
        "offline_capability": { "type": "boolean", "default": false, "description": "オフライン同期が必要" },
        "payment_billing": { "type": "boolean", "default": false, "description": "決済/課金ロジック" },
        "pii_handling": { "type": "boolean", "default": false, "description": "個人情報（PII）の取り扱い" },
        "novel_domain": { "type": "boolean", "default": false, "description": "プロジェクトに新しいドメイン概念を導入" },
        "cross_feature_impact": { "type": "boolean", "default": false, "description": "他の機能に影響を与える変更" }
      }
    },

    "archived_reason": {
      "type": "string",
      "enum": ["merged", "superseded", "deferred", "abandoned", "duplicate"],
      "description": "Archived状態の理由（current_stateがArchivedの場合のみ有効）。merged: 他の機能に統合、superseded: 新機能に置き換え、deferred: 無期限保留、abandoned: 破棄、duplicate: 重複"
    },

    "archived_ref": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$",
      "description": "統合/置換先のFeature ID（archived_reasonがmergedまたはsupersededの場合は必須）"
    },

    "quick_resume": {
      "type": "object",
      "description": "セッション再開時に3秒以内で状況把握するための項目",
      "required": ["current_state", "current_task", "next_actions", "last_updated_at"],
      "properties": {
        "current_state": {
          "type": "string",
          "enum": [
            "Idle",
            "Discovery",
            "Briefing",
            "SpecDrafting",
            "SpecUpdating",
            "Implementing",
            "BugFixing",
            "SyncingStatus",
            "Reviewing",
            "Done",
            "Blocked",
            "AwaitingUser",
            "Failed",
            "SpecApproved",
            "Archived"
          ],
          "description": "現在の状態マシンの状態。AwaitingUser: ユーザー応答待ち、Failed: 復旧不可能な失敗、SpecApproved: SPEC承認後、実装待ち、Archived: 保留/破棄"
        },
        "current_task": {
          "type": "string",
          "description": "現在進行中の作業（1文）"
        },
        "next_actions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "次に行う作業リスト（2〜3件）"
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "進行を妨げる障害（Blocked状態の場合）"
        },
        "last_updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "最終更新日時（ISO 8601）"
        },
        "last_decision": {
          "type": "object",
          "description": "直近の決定事項（迅速なコンテキスト復元用）",
          "properties": {
            "summary": { "type": "string" },
            "at": { "type": "string", "format": "date-time" }
          }
        },
        "current_rationale": {
          "type": "string",
          "description": "現在の作業を行う理由（判断根拠）"
        },
        "active_constraints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "現在適用中の制約条件（CLAUDE.mdからの抜粋）"
        },
        "previous_state": {
          "type": ["string", "null"],
          "description": "直前の状態（Blocked/AwaitingUserから復帰する際に参照）"
        },
        "question_count": {
          "type": "integer",
          "default": 0,
          "description": "現在のセッションでユーザーに行った質問数（7問上限ルール）"
        }
      }
    },

    "progress": {
      "type": "object",
      "description": "FRベースの進捗率",
      "properties": {
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "進捗率（0〜100）"
        },
        "fr_total": {
          "type": "integer",
          "description": "全FR数"
        },
        "fr_completed": {
          "type": "integer",
          "description": "完了したFR数"
        },
        "fr_in_progress": {
          "type": "integer",
          "description": "進行中のFR数"
        },
        "details": {
          "type": "object",
          "description": "FRごとの詳細状態。v5ではobject形式のみ許可（string禁止）。",
          "additionalProperties": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["not_started", "pending", "in_progress", "partial", "completed"]
              },
              "weight": {
                "type": "number",
                "default": 1
              },
              "files": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },

    "why": {
      "type": "string",
      "minLength": 10,
      "description": "この機能が必要な理由（コンテキスト消失防止の核心）"
    },

    "success_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "description": "成功条件リスト"
    },

    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "制約条件（技術的/ビジネス的）"
    },

    "artifacts": {
      "type": "object",
      "description": "生成された成果物のパス",
      "properties": {
        "brief": {
          "type": ["string", "null"],
          "description": "BRIEF.mdのパス。feature-architectが生成。例: docs/features/001-user-dashboard/BRIEF.md"
        },
        "brief_format_version": {
          "type": ["string", "null"],
          "enum": ["v2.0", "auto-migrated", "candidate-derived", "legacy", null],
          "description": "BRIEF.mdのフォーマットバージョン。v2.0: Template v2.0準拠、auto-migrated: 自動マイグレーション、candidate-derived: 候補からの変換、legacy: 旧フォーマット"
        },
        "spec": { "type": ["string", "null"] },
        "spec_version": {
          "type": ["string", "null"],
          "description": "SPECバージョン（例: v1.0, v1.1）"
        },
        "spec_locked_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "SPECバージョン確定時点（Readiness Gate Go時点）"
        },
        "spec_validation": {
          "type": ["object", "null"],
          "description": "SPEC機械検証結果",
          "properties": {
            "last_run_at": { "type": ["string", "null"], "format": "date-time" },
            "verdict": {
              "type": ["string", "null"],
              "enum": ["Go", "Conditional Go", "No-Go", null]
            },
            "blocking_count": { "type": "integer" },
            "warning_count": { "type": "integer" }
          }
        },
        "screens": {
          "type": "array",
          "items": { "type": "string" }
        },
        "design_assets": {
          "type": ["object", "null"],
          "description": "任意。Figma Exportなどのデザインアセット。design/ディレクトリにファイルがある場合のみ記入。SSOTはScreen Docであり、デザインアセットは視覚参考用。",
          "properties": {
            "directory": {
              "type": ["string", "null"],
              "description": "デザインアセットディレクトリのパス（例: docs/features/025-authentication-flow/design/）"
            },
            "files": {
              "type": "array",
              "items": { "type": "string" },
              "description": "デザインアセットファイルのリスト（例: [\"code.html\", \"screen.png\"]）"
            }
          }
        },
        "index": { "type": ["string", "null"] }
      }
    },

    "references": {
      "type": "object",
      "description": "参照文書及びコード（旧context_manifestの役割）",
      "properties": {
        "priority_order": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["spec", "screens", "brief"]
        },
        "current_focus": {
          "type": "object",
          "properties": {
            "document": { "type": "string" },
            "section": { "type": "string" },
            "reason": { "type": "string" }
          }
        },
        "documents": {
          "type": "object",
          "description": "参照文書の詳細（spec、screens、briefのパス及びフォーカス）",
          "properties": {
            "spec": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "sections_to_read": { "type": "array", "items": { "type": "string" } },
                "focus": { "type": "array", "items": { "type": "string" } }
              }
            },
            "screens": {
              "type": "object",
              "properties": {
                "paths": { "type": "array", "items": { "type": "string" } },
                "focus": { "type": "array", "items": { "type": "string" } }
              }
            },
            "brief": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "sections_to_read": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "related_specs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_code": {
          "type": "object",
          "description": "関連コードファイルのパス",
          "properties": {
            "feature_path": {
              "type": ["string", "null"],
              "description": "機能コードのルートパス（例: src/features/auth/）"
            },
            "barrel_file": { "type": ["string", "null"], "description": "バレルファイルのパス" },
            "di_providers": {
              "type": ["string", "null"],
              "description": "DIプロバイダーファイルのパス"
            },
            "models": { "type": "array", "items": { "type": "string" } },
            "repositories": { "type": "array", "items": { "type": "string" } },
            "viewmodels": { "type": "array", "items": { "type": "string" } },
            "services": { "type": "array", "items": { "type": "string" } },
            "pages": { "type": "array", "items": { "type": "string" } },
            "widgets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "db_tables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "edge_functions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "features": { "type": "array", "items": { "type": "string" } },
            "packages": { "type": "array", "items": { "type": "string" } }
          }
        },
        "research_links": {
          "type": "object",
          "properties": {
            "research_ids": { "type": "array", "items": { "type": "string" } },
            "id_format": { "type": "string" },
            "comp_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^comp-[0-9]{3}$" },
              "description": "関連する競合分析IDリスト（gap-candidates.json参照）"
            }
          }
        }
      }
    },

    "competitive_data": {
      "type": ["object", "null"],
      "description": "競合分析データ（gap-candidates + competitor-registryから抽出）",
      "properties": {
        "comp_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^comp-[0-9]{3}$" }
        },
        "gap_severity": {
          "type": ["string", "null"],
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "N/A", null]
        },
        "is_industry_standard": {
          "type": "boolean",
          "default": false
        },
        "app_count": {
          "type": "integer",
          "default": 0
        },
        "linked_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },

    "architecture": {
      "type": ["object", "null"],
      "description": "Phase 0 Discovery & Architecture 成果物（v6新規）。domain-modeler、architecture-selector、system-designerが生成した成果物のパス及び要約。feature-architectがStep 1でnullに初期化し、Step 1.5 Discovery Gate通過後にfeature-pilotが更新する。",
      "properties": {
        "domain_model": {
          "type": ["object", "null"],
          "description": "domain-modelerの成果物",
          "properties": {
            "path": {
              "type": ["string", "null"],
              "description": "DOMAIN-MODEL.mdファイルのパス"
            },
            "bounded_contexts": {
              "type": "array",
              "items": { "type": "string" },
              "description": "識別されたBounded Contextのリスト"
            },
            "ubiquitous_language_count": {
              "type": "integer",
              "description": "定義されたユビキタス言語用語数"
            },
            "generated_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "adr": {
          "type": ["object", "null"],
          "description": "architecture-selectorの成果物",
          "properties": {
            "path": {
              "type": ["string", "null"],
              "description": "ADR文書ファイルのパス"
            },
            "decision_title": {
              "type": ["string", "null"],
              "description": "アーキテクチャ決定タイトル"
            },
            "chosen_option": {
              "type": ["string", "null"],
              "description": "選択されたアーキテクチャオプション"
            },
            "alternatives_count": {
              "type": "integer",
              "description": "検討した代替案の数（最低3）"
            },
            "generated_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "system_design": {
          "type": ["object", "null"],
          "description": "system-designerの成果物",
          "properties": {
            "path": {
              "type": ["string", "null"],
              "description": "SYSTEM-DESIGN.mdファイルのパス"
            },
            "c4_levels": {
              "type": "array",
              "items": { "type": "string", "enum": ["L1-Context", "L2-Container"] },
              "description": "生成されたC4ダイアグラムレベル"
            },
            "external_systems": {
              "type": "array",
              "items": { "type": "string" },
              "description": "識別された外部システムのリスト"
            },
            "generated_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "discovery_gate": {
          "type": ["object", "null"],
          "description": "Discovery Gate検証結果",
          "properties": {
            "verdict": {
              "type": ["string", "null"],
              "enum": ["Go", "Conditional Go", "No-Go", null]
            },
            "verified_at": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "blocking_count": {
              "type": "integer",
              "default": 0
            },
            "warning_count": {
              "type": "integer",
              "default": 0
            }
          }
        },
        "infra_assessment": {
          "type": ["object", "null"],
          "description": "infra-selectorの成果物。NFR分析、技術パターン選定、サービスマッピング結果の要約。",
          "properties": {
            "nfr_composite_profile": {
              "type": ["string", "null"],
              "description": "NFR組み合わせプロファイル（例: async-eventual-medium）"
            },
            "selected_patterns": {
              "type": "array",
              "items": { "type": "string" },
              "description": "選定された技術パターンIDリスト"
            },
            "provider": {
              "type": ["string", "null"],
              "enum": ["aws", "gcp", null],
              "description": "選定されたプロバイダー"
            },
            "contract_path": {
              "type": ["string", "null"],
              "description": "infrastructure-contract.jsonのパス"
            },
            "generated_at": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        },
        "discovery_rationale": {
          "type": ["string", "null"],
          "description": "AIがどのDiscoveryスキルを実行し、なぜそうしたのかの根拠。characteristicsに基づく判断の記録。"
        }
      }
    },

    "execution": {
      "type": "object",
      "description": "実行状態",
      "properties": {
        "lock": {
          "type": "object",
          "properties": {
            "locked": { "type": "boolean" },
            "locked_by": { "type": ["string", "null"] },
            "locked_at": { "type": ["string", "null"] },
            "lock_expires_at": {
              "type": ["string", "null"],
              "format": "date-time",
              "description": "ロック有効期限。locked_at + 30分。この時間を過ぎたロックは古いものとみなす"
            }
          }
        },
        "active_branch": { "type": ["string", "null"] },
        "rollback_point": { "type": ["string", "null"] },
        "worktree": {
          "type": ["object", "null"],
          "description": "Git worktreeベースの作業引き継ぎ情報。feature-pilotが機能開発の開始/再開/完了時に更新する。",
          "required": ["branch", "worktree_path", "plan_path", "status", "last_updated", "handoff"],
          "properties": {
            "branch": {
              "type": ["string", "null"],
              "pattern": "^(feature|fix|chore|docs|refactor|test|hotfix)/[a-z0-9._-]+(/[a-z0-9._-]+)*$",
              "description": "GitHub Flow形式の作業ブランチ名"
            },
            "worktree_path": {
              "type": ["string", "null"],
              "pattern": "^\\.worktrees/(feature|fix|chore|docs|refactor|test|hotfix)/[a-z0-9._-]+(/[a-z0-9._-]+)*$",
              "description": ".worktrees/配下のworktreeパス"
            },
            "plan_path": {
              "type": ["string", "null"],
              "pattern": "^\\.worktrees/(feature|fix|chore|docs|refactor|test|hotfix)/[a-z0-9._-]+(/[a-z0-9._-]+)*/PLAN\\.md$",
              "description": "worktreeルートのPLAN.mdパス"
            },
            "status": {
              "type": ["string", "null"],
              "enum": ["active", "paused", "completed", null],
              "description": "worktree作業状態"
            },
            "last_updated": {
              "type": ["string", "null"],
              "format": "date-time",
              "description": "worktree情報の最終更新時刻"
            },
            "handoff": {
              "type": ["string", "null"],
              "description": "次のセッションが引き継ぐための現在の状態/注意点"
            }
          },
          "additionalProperties": false
        }
      }
    },

    "decisions": {
      "type": "array",
      "description": "決定履歴",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "summary": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },

    "open_questions": {
      "type": "array",
      "description": "未解決の質問",
      "items": {
        "type": "object",
        "required": ["id", "question", "status"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" },
          "status": { "type": "string", "enum": ["open", "resolved"] },
          "type": { "type": "string", "enum": ["question", "assumption", "risk"] },
          "impact": { "type": "string" },
          "resolution": { "type": ["string", "null"] }
        }
      }
    },

    "history": {
      "type": "array",
      "description": "状態遷移履歴",
      "items": {
        "type": "object",
        "required": ["at", "from_state", "to_state", "triggered_by"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "from_state": { "type": ["string", "null"] },
          "to_state": { "type": "string" },
          "triggered_by": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },

    "autonomy_control": {
      "type": "object",
      "description": "AI自律性制御（7問上限ルール、自律停止条件）",
      "properties": {
        "max_questions_per_session": {
          "type": "integer",
          "default": 7,
          "description": "セッションあたりの最大質問数（超過時はAwaitingUserに遷移）"
        },
        "auto_stop_conditions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "自律停止条件リスト",
          "default": [
            "7問質問上限到達",
            "BLOCKINGパターン発見",
            "高リスク作業（security_sensitive, payment_billing, pii_handling）",
            "DBマイグレーションが必要"
          ]
        },
        "current_autonomy_level": {
          "type": "string",
          "enum": ["full", "supervised", "paused"],
          "default": "supervised",
          "description": "現在の自律性レベル。full: 完全自律、supervised: 重要な決定時に確認、paused: ユーザー入力待ち"
        },
        "risk_level": {
          "type": ["string", "null"],
          "enum": ["high", "medium", "low", null],
          "description": "characteristicsから自動導出されたリスクレベル"
        },
        "risk_factors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "リスクレベル判定の根拠となったcharacteristicsのリスト"
        },
        "claude_md_checked": {
          "type": "boolean",
          "default": false,
          "description": "CLAUDE.md参照の有無（Phase 0で強制チェック）"
        },
        "claude_md_version": {
          "type": ["string", "null"],
          "description": "参照したCLAUDE.mdの最終更新日"
        }
      }
    },

    "traceability": {
      "type": "object",
      "description": "BRIEF ↔ SPEC トレーサビリティマッピング。spec-generatorがSPEC生成後に記入。",
      "properties": {
        "user_story_to_fr": {
          "type": "array",
          "description": "User Story → FR マッピング",
          "items": {
            "type": "object",
            "required": ["user_story_id", "fr_ids"],
            "properties": {
              "user_story_id": {
                "type": "string",
                "description": "BRIEF Section 2のUser Story ID（例: US-01）"
              },
              "fr_ids": {
                "type": "array",
                "items": { "type": "string" },
                "description": "マッピングされたFR IDリスト（例: [\"FR-02901\", \"FR-02902\"]）"
              }
            }
          }
        },
        "bdd_to_fr": {
          "type": "array",
          "description": "BDD Scenario → FR マッピング",
          "items": {
            "type": "object",
            "required": ["scenario_name", "fr_ids"],
            "properties": {
              "scenario_name": {
                "type": "string",
                "description": "BRIEF Section 4のACシナリオ名（例: AC-01）"
              },
              "fr_ids": {
                "type": "array",
                "items": { "type": "string" },
                "description": "マッピングされたFR IDリスト"
              }
            }
          }
        },
        "unmapped_user_stories": {
          "type": "array",
          "items": { "type": "string" },
          "description": "FRにマッピングされていないUser Story IDリスト"
        },
        "unmapped_bdd_scenarios": {
          "type": "array",
          "items": { "type": "string" },
          "description": "FRにマッピングされていないBDDシナリオ名リスト"
        },
        "validated_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Readiness Gate Phase 1.5の最終検証時点"
        }
      }
    },

    "priority": {
      "type": "object",
      "description": "RICE v2優先順位（priority-analyzerが管理）。rice-section-schema.jsonがSSOT。",
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "schema": { "type": "string", "enum": ["rice-v2"] },
        "last_updated": { "type": ["string", "null"], "format": "date-time" },
        "phase": { "type": "string", "enum": ["exploration", "mvp", "growth", "stability"] },
        "rice_inputs": {
          "type": "object",
          "properties": {
            "reach": {
              "type": "object",
              "properties": {
                "score": { "type": "number", "minimum": 1, "maximum": 10 },
                "evidence": { "type": "object" },
                "rationale": { "type": "string" }
              }
            },
            "impact": {
              "type": "object",
              "properties": {
                "score": { "type": "number", "enum": [0.25, 0.5, 1, 2, 3] },
                "evidence": { "type": "object" },
                "rationale": { "type": "string" }
              }
            },
            "confidence": {
              "type": "object",
              "properties": {
                "score": { "type": "number", "minimum": 0.05, "maximum": 1.0 },
                "factors": { "type": "object" }
              }
            },
            "effort": {
              "type": "object",
              "properties": {
                "score": { "type": "number", "minimum": 0.5, "maximum": 20 },
                "unit": { "type": "string", "const": "person-weeks" },
                "evidence": { "type": "object" },
                "rationale": { "type": "string" }
              }
            }
          }
        },
        "competitive_adjustment": {
          "type": "object",
          "properties": {
            "adjustment": { "type": "number", "minimum": 0.8, "maximum": 1.3, "default": 1.0 },
            "has_data": { "type": "boolean" },
            "evidence": { "type": "object" },
            "rationale": { "type": "string" }
          }
        },
        "calculated": {
          "type": "object",
          "required": ["rice_score", "formula"],
          "properties": {
            "rice_score": { "type": "number", "minimum": 0 },
            "adjusted_score": { "type": "number", "minimum": 0 },
            "competitive_adjustment": { "type": "number", "minimum": 0.8, "maximum": 1.3 },
            "manual_override_applied": { "type": "number", "minimum": 0.8, "maximum": 1.2 },
            "formula": { "type": "string" },
            "component_breakdown": { "type": "object" }
          }
        },
        "data_sources_read": { "type": "array", "items": { "type": "string" } },
        "manual_override": {
          "type": "object",
          "properties": {
            "value": { "type": "number", "minimum": 0.8, "maximum": 1.2, "default": 1.0 },
            "reason": { "type": ["string", "null"] }
          }
        },
        "ai_rationale": { "type": "string" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": { "type": "string", "format": "date-time" },
              "actor": { "type": "string", "enum": ["ai", "human"] },
              "change_summary": { "type": "string" },
              "rice_score": { "type": "number" },
              "adjusted_score": { "type": "number" },
              "inputs_snapshot": { "type": "object" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },

    "brief_context": {
      "type": ["object", "null"],
      "description": "BRIEF.mdの要約（brief_regenerator.pyが生成）",
      "properties": {
        "core_goal": { "type": ["string", "null"] },
        "user_value": { "type": ["string", "null"] },
        "business_metrics": { "type": ["array", "null"], "items": { "type": "string" } },
        "user_story": { "type": ["string", "null"] },
        "priority_label": { "type": ["string", "null"] }
      }
    },

    "completion_summary": {
      "type": ["object", "null"],
      "description": "Feature実装完了時に何が作られたかを構造化して記録。feature-status-syncがコードから自動抽出。他のfeatureがこのfeatureに依存する際に参照する唯一のソース。GSD Slice Summaryパターンを適用。v8で追加。",
      "properties": {
        "produces": {
          "type": "object",
          "description": "このfeatureが外部に提供するもの",
          "properties": {
            "types": {
              "type": "array",
              "items": { "type": "string" },
              "description": "exportされた型/インターフェース名（例: [\"User\", \"AuthToken\", \"LoginRequest\"]）"
            },
            "exports": {
              "type": "array",
              "items": { "type": "string" },
              "description": "exportされた関数/コンポーネントのシグネチャ（例: [\"generateToken()\", \"LoginForm\", \"useAuth()\"]）"
            },
            "api_endpoints": {
              "type": "array",
              "items": { "type": "string" },
              "description": "作成されたAPIエンドポイント（例: [\"POST /api/auth/login\", \"GET /api/auth/me\"]）"
            },
            "patterns_established": {
              "type": "array",
              "items": { "type": "string" },
              "description": "このfeatureが確立したパターン（例: [\"JWT refresh rotation\", \"Zod request validation\"]）"
            }
          }
        },
        "consumes": {
          "type": "object",
          "description": "このfeatureが他のfeatureから使用するもの",
          "properties": {
            "from_features": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["feature_id", "imports"],
                "properties": {
                  "feature_id": { "type": "string", "description": "依存先feature ID" },
                  "imports": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "該当featureからimportする項目（例: [\"generateToken()\", \"User\"]）"
                  }
                }
              }
            }
          }
        },
        "files_created": {
          "type": "array",
          "items": { "type": "string" },
          "description": "作成されたファイルパスのリスト（動的パスプレースホルダーを使用）"
        },
        "generated_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "summary生成時刻"
        },
        "generated_by": {
          "type": "string",
          "enum": ["feature-status-sync", "manual"],
          "description": "生成主体"
        }
      }
    },

    "completion_contract": {
      "type": ["object", "null"],
      "description": "DoD（Definition of Done）の構造化追跡。BRIEF §7をSSOTとし、パイプラインが自動追跡する。v7で追加。nullの場合は未初期化（後方互換）。",
      "properties": {
        "version": {
          "type": "string",
          "description": "completion_contractスキーマバージョン"
        },
        "work_type": {
          "type": ["string", "null"],
          "enum": ["NEW_FEATURE", "MODIFY_FEATURE", "BUG_FIX", null],
          "description": "作業タイプ。base_dodのロードに使用"
        },
        "source": {
          "type": "string",
          "description": "DoD定義のソース（例: BRIEF §7）"
        },
        "last_verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "最終検証時刻"
        },
        "verdict": {
          "type": ["string", "null"],
          "enum": ["passed", "failed", "partial", null],
          "description": "最終判定。passed: 全項目通過、failed: machine/aiの失敗あり、partial: humanの未確認のみ"
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/dod_item" },
          "description": "DoD項目リスト"
        },
        "summary": {
          "type": "object",
          "description": "DoD検証サマリー",
          "properties": {
            "total": { "type": "integer", "description": "全項目数" },
            "passed": { "type": "integer", "description": "通過項目数" },
            "failed": { "type": "integer", "description": "失敗項目数" },
            "skipped": { "type": "integer", "description": "スキップ項目数" },
            "pass_rate": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 100,
              "description": "通過率（%）"
            }
          }
        }
      }
    },

    "esp_execution_log": {
      "type": "object",
      "description": "ESP（Enforced Skill Pattern）実行記録（長期運用の検証可能な証跡）"
    }
  },

  "$defs": {
    "dod_item": {
      "type": "object",
      "required": ["id", "level", "description", "verification_type", "status"],
      "description": "DoD個別項目の定義",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DoD-(FT|FS|FR)-[0-9]{2}$",
          "description": "DoD項目ID。FT: Feature-Level（Base DoD）、FS: Feature-Specific（§7.1）、FR: FR-Level"
        },
        "level": {
          "type": "string",
          "enum": ["fr", "feature", "specific"],
          "description": "DoDレベル。fr: FR単位、feature: 機能全体（Base DoD）、specific: 機能固有（§7.1）"
        },
        "description": {
          "type": "string",
          "description": "完了条件の説明"
        },
        "verification_type": {
          "type": "string",
          "enum": ["machine", "ai", "human"],
          "description": "検証タイプ。machine: コマンド実行で検証、ai: AIが判定、human: ユーザー確認"
        },
        "observation": {
          "type": "string",
          "description": "具体的な観測方法"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "skipped", "blocked"],
          "description": "検証状態"
        },
        "verified_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "検証完了時刻"
        },
        "evidence": {
          "type": ["string", "null"],
          "description": "検証根拠（コマンド出力、AI判定理由など）"
        }
      }
    }
  }
}
