GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
# SREエージェント実実行 (APIキー未設定時はVertex AI + ADCで動作)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
OPS_TARGET_SERVICE=a2a-agent-marketplace
# エントリは "service" または "<gcp-project>/service" (別GCPプロジェクトのログを対象化)
OPS_TARGET_ALLOWLIST=a2a-agent-marketplace,aitech-good-a13973/vibementor-ai
OPS_RUN_STORE=
