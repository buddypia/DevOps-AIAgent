GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
# SREエージェント実実行 (APIキー未設定時はVertex AI + ADCで動作)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
OPS_TARGET_SERVICE=agent-guild
# エントリは "service" または "<gcp-project>/service" (別GCPプロジェクトのログを対象化)
OPS_TARGET_ALLOWLIST=agent-guild
# 外部Agent Cardの実A2A委任を許可するorigin。空欄ならCard評価のみ。
OPS_EXTERNAL_A2A_ALLOWLIST=
OPS_EXTERNAL_A2A_TIMEOUT_MS=6000
OPS_RUN_STORE=
