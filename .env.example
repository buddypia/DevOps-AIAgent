GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
# A2Aは既定で停止。外部公開する場合は32文字以上のSecret Manager値を設定し、リクエストにx-a2a-tokenを付与する。
A2A_ENABLED=false
A2A_ACTION_TOKEN=
# SREエージェント実実行 (APIキー未設定時はVertex AI + ADCで動作)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
OPS_TARGET_SERVICE=agent-guild
# エントリは "service" または "<gcp-project>/service" (別GCPプロジェクトのログを対象化)
OPS_TARGET_ALLOWLIST=agent-guild
# 外部Agent Cardの実A2A委任を許可するorigin。空欄ならCard評価のみ。
OPS_EXTERNAL_A2A_ALLOWLIST=
OPS_EXTERNAL_A2A_TIMEOUT_MS=6000
OPS_RUN_STORE=
# Merge Steward: fine-grained tokenをSecret Manager経由で設定。
# Issues: write、Pull requests: read、Contents: writeの必要最小権限を付与する。branch protection/rulesetのbypass権限は付与しない。
OPS_GITHUB_REPO=buddypia/DevOps-AIAgent
OPS_GITHUB_TOKEN=
# 32文字以上のGitHub操作専用承認コード。GitHub tokenとは別の値にする。
OPS_MERGE_STEWARD_ACTION_TOKEN=
