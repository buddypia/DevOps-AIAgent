# Copy this file to .envrc, then run: direnv allow .
# Do not source ~/.zshrc here: this project must not inherit another project's
# Gemini or Google Cloud credentials.

unset GEMINI_API_KEY GOOGLE_API_KEY GOOGLE_GENERATIVE_AI_API_KEY
unset GOOGLE_CLOUD_PROJECT GOOGLE_CLOUD_LOCATION GOOGLE_APPLICATION_CREDENTIALS

export GEMINI_MODEL="gemini-3.5-flash"
export GOOGLE_CLOUD_PROJECT="sixth-oath-502008-u3"
export GOOGLE_CLOUD_LOCATION="asia-northeast1"
export OPS_TARGET_SERVICE="a2a-agent-marketplace"
export OPS_TARGET_ALLOWLIST="a2a-agent-marketplace"
export OPS_RUN_STORE="memory"
export PUBLIC_BASE_URL="http://localhost:8080"
export PORT="8080"

dotenv_if_exists .env.local
