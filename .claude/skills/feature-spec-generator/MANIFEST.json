{
  "schema_version": 2,
  "skill_id": "feature-spec-generator",
  "tier": 2,
  "tier_description": "Pipeline - CONTEXT.json ベースのSPEC.md + Screen文書生成",
  "enforced_protocol": {
    "version": "2.0",
    "preflight_required": false,
    "postflight_required": false,
    "model_routing_required": false,
    "evidence_caching_enabled": false
  },
  "model_routing": {
    "default_model": "sonnet",
    "task_specific": {
      "context_reading": "sonnet",
      "spec_generation": "sonnet",
      "screen_wireframe": "sonnet"
    },
    "fallback_chain": [
      "sonnet"
    ]
  },
  "evidence_policy": {
    "note": "SPEC生成はCONTEXT.jsonベース。毎回fresh な文書を生成"
  },
  "public_api": {
    "direct_invocable": true,
    "trigger_keywords": [
      "SPEC生成",
      "SPEC作成",
      "仕様書生成",
      "明細書生成"
    ],
    "args_pattern": "<機能ID> [--req <追加要件>]"
  },
  "dependencies": {
    "required": [
      "feature-architect"
    ],
    "optional": []
  },
  "called_by": [
    "feature-pilot",
    "feature-architect"
  ],
  "calls": [],
  "outputs": [
    {
      "type": "file",
      "path_pattern": "docs/features/<id>-<name>/SPEC-<id>-<name>.md",
      "description": "機能仕様書"
    },
    {
      "type": "directory",
      "path_pattern": "docs/features/<id>-<name>/screens/",
      "description": "画面文書ディレクトリ"
    },
    {
      "type": "file",
      "path_pattern": "docs/features/<id>-<name>/screens/*.md",
      "description": "個別の画面文書"
    }
  ],
  "state_transitions": {
    "context_json_field": "quick_resume.current_state",
    "valid_transitions": [
      {
        "from": "SpecDrafting",
        "to": "SpecDrafting"
      }
    ]
  },
  "ssot_files": [],
  "references": [
    {
      "file": "references/error-rescue-map-template.md",
      "description": "エラー&レスキューマップテンプレート。画面別エラー状態+復旧経路の定義。gstack plan-ceo-reviewから移植。",
      "transplant_source": "tp-gstack-20260325"
    },
    {
      "file": "references/interaction-state-coverage-template.md",
      "description": "インタラクション状態カバレッジテンプレート。コンポーネント別状態マトリクス。gstack plan-design-reviewから移植。",
      "transplant_source": "tp-gstack-20260325"
    },
    {
      "file": "references/spec-generation-protocol-details.md",
      "description": "長文SPEC生成プロトコルのarchive。詳細な質問リスト、API/NFRテンプレート、並列実装ガイド例が必要な時にon-demandで読む。"
    }
  ]
}
