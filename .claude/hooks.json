{
  "devops-aiagent-guards": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-policy-guard.mjs antigravity PreToolUse",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-session-owner-guard.mjs antigravity PreToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/destructive-git-guard.mjs antigravity PreToolUse",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/commit-guard.mjs antigravity PreToolUse",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-session-owner-guard.mjs antigravity PreToolUse",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/pre-ship-review-guard.mjs antigravity PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-owner-tracker.mjs antigravity PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .cli/hooks/worktree-shipping-guard.mjs antigravity Stop",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "node \"$(git rev-parse --show-toplevel)/.cli/_cli-dispatch.mjs\" .claude/hooks/completion-evidence-guard.mjs antigravity Stop",
        "timeout": 10
      }
    ]
  }
}
