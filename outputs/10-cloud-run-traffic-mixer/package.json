{
  "name": "cloud-run-traffic-mixer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud Run Traffic Mixer: Plans staged Cloud Run revision traffic shifts from live signals.",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "start": "node dist/server/server.js",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "2.5.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "zod": "4.4.3",
    "express-rate-limit": "8.5.2",
    "helmet": "8.1.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.9.1",
    "concurrently": "9.2.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
